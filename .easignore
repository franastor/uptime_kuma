# .easignore — EAS Build/Update usa ESTE fichero (si existe) en lugar de
# .gitignore para decidir qué se excluye del archive que se sube al build.
# Espejo de .gitignore EXCEPTO google-services.json: ese fichero se
# materializa localmente (scripts/load-secrets.sh, desde Infisical) y DEBE
# entrar en el archive para que el prebuild de Android lo encuentre
# (app.json → android.googleServicesFile).

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Metro
.metro-health-check*

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Build
android/build/
android/app/build/
ios/build/

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Environment
.env
.env.*
!.env.example

# Firebase / credenciales móviles (NUNCA subir) — google-services.json NO se
# excluye aquí (materializado por scripts/load-secrets.sh antes del build)
GoogleService-Info.plist
*-firebase*.json
*firebase-adminsdk*.json
*-service-account*.json
service-account*.json
credentials/
credenciales/

# TypeScript
*.tsbuildinfo

# Examples
app-example

# Generated native folders (solo si usas Expo Managed)
# Si algún día haces:
# npx expo prebuild
# elimina estas dos líneas.
ios/
android/

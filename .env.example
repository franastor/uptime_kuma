# KumaPulse — variables de entorno (copiar a .env y rellenar)
# El .env NO se sube a git (ver .gitignore). Con el prefijo EXPO_PUBLIC_
# Expo la expone al código de la app en build time.

# URL del backend kumapulse-push (contenedor en el homelab)
EXPO_PUBLIC_PUSH_BACKEND_URL=http://192.168.1.18:5830

# APP_KEY del backend (en /home/franastor/portainer/kumapulse-push/.env del servidor)
# Solo permite registrar tokens, nunca enviar push.
EXPO_PUBLIC_PUSH_APP_KEY=pon_aqui_la_APP_KEY
